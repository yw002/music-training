<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- T24 §9.2.3 安全审计基线：本 App 只做本地音频合成播放，
	     不联网、不录音。以下三项**必须始终不存在**：
	       com.apple.security.network.client
	       com.apple.security.device.audio-input
	       com.apple.security.device.camera
	     （已核对：本文件历史上也未出现过这三项。） -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Flutter Debug/Profile 模板自带，Dart VM JIT 必需。 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Flutter Debug/Profile 模板自带：本机 VM Service / 热重载所需的
	     回环监听。仅 Debug/Profile 使用，Release.entitlements 中**不得**出现。 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- T24 新增：T17 数据管理用 file_selector 做 JSON 导出/导入，
	     沙盒下必须显式声明「用户选定文件读写」权限，否则保存/打开对话框返回的
	     文件句柄不可用。仅限用户主动选中的文件，不扩大沙盒范围。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
