# =============================================================================
# tool/signing.env.example —— 签名占位变量模板（架构 §9.5）
#
# 用法：
#   cp tool/signing.env.example tool/signing.env
#   然后填入真实值。tool/signing.env 已加入 .gitignore，**不要提交**。
#
# 各构建脚本会在存在时自动 source（tool/build_macos.sh、tool/build_ios.sh）。
# =============================================================================

# Apple 开发者团队 ID。
# 未设置 → iOS 走 `flutter build ios --release --no-codesign`（产物不可安装）。
# 示例：TEAM_ID=A1B2C3D4E5
# export TEAM_ID=""

# macOS 签名证书名。
# 未设置 → macOS 走 Xcode 默认/本地临时签名（仅本机可运行）。
# 示例：CODESIGN_IDENTITY="Developer ID Application: Foo (A1B2C3D4E5)"
# export CODESIGN_IDENTITY=""

# notarytool 的 keychain profile 名（公证用）。
# 未设置 → tool/build_macos.sh 跳过公证。
# 创建方式：
#   xcrun notarytool store-credentials eartrain-notary \
#     --apple-id "you@example.com" --team-id "A1B2C3D4E5" --password "<app-专用密码>"
# export NOTARIZE_PROFILE=""

# Android 构建目标：apk（默认）| appbundle
# export ANDROID_BUILD_TARGET="apk"
