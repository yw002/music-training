<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ios/ExportOptions.plist —— iOS 归档导出配置（批次 E+ · T24 / 架构 §9.3.4）

  仅当设置了环境变量 TEAM_ID 时，tool/build_ios.sh 才会用到本文件：
      TEAM_ID=A1B2C3D4E5 ./tool/build_ios.sh
  未设置 TEAM_ID 时走 `flutter build ios --release --no-codesign`，不读本文件。

  ⚠️ teamID 为**占位值**，必须替换为真实的 Apple 开发者团队 ID 后才能导出。
     本机无法验证导出流程（需真机证书与描述文件），见 README「本机验证状态」。

  method 可选值：development / ad-hoc / app-store-connect / enterprise
    - development       ：内部真机调试（默认，门槛最低）
    - app-store-connect ：上架 App Store
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>

	<!-- 占位：替换为真实团队 ID，例如 A1B2C3D4E5 -->
	<key>teamID</key>
	<string>REPLACE_WITH_TEAM_ID</string>

	<!-- automatic：由 Xcode 自动匹配证书与描述文件，门槛最低。
	     若走 CI 固定描述文件，改为 manual 并补 provisioningProfiles 字典。 -->
	<key>signingStyle</key>
	<string>automatic</string>

	<key>stripSwiftSymbols</key>
	<true/>

	<!-- Bitcode 自 Xcode 14 起已废弃，明确关闭避免告警。 -->
	<key>uploadBitcode</key>
	<false/>
	<key>compileBitcode</key>
	<false/>

	<!-- 本 App 无崩溃上报后端，不上传符号表。 -->
	<key>uploadSymbols</key>
	<false/>

	<!-- 只构建当前架构对应的瘦身包，减小体积。 -->
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
